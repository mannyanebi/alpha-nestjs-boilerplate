{
  "compilerOptions": {
    // Module settings
    "module": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "Node",
    "target": "ESNext",

    // Emit settings
    "declaration": true,
    "removeComments": true,
    "noEmit": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,

    // Module resolution
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    // NestJS decorators
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    // Type checking - relaxed for better DX
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,

    // Path aliases - eliminates ../../ imports
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@common/*": ["./common/*"],
      "@constants/*": ["./constants/*"],
      "@database/*": ["./database/*"],
      "@decorators/*": ["./decorators/*"],
      "@entity-subscribers/*": ["./entity-subscribers/*"],
      "@exceptions/*": ["./exceptions/*"],
      "@filters/*": ["./filters/*"],
      "@guards/*": ["./guards/*"],
      "@interceptors/*": ["./interceptors/*"],
      "@interfaces/*": ["./interfaces/*"],
      "@modules/*": ["./modules/*"],
      "@providers/*": ["./providers/*"],
      "@shared/*": ["./shared/*"],
      "@types/*": ["./types/*"],
      "@validators/*": ["./validators/*"]
    }
  },
  "ts-node": {
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true,
    "esm": true
  },
  "include": [
    "src/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}
