NODE_ENV=development

#== APP
PORT=5500
TRANSPORT_PORT=8080
JWT_EXPIRATION_TIME=3600
FALLBACK_LANGUAGE=en_US
ENABLE_ORM_LOGS=true
ENABLE_DOCUMENTATION=true
API_VERSION=v1.0.0

#== AUTO SEEDING (Development Only)
ENABLE_AUTO_SEED=true
DEV_ADMIN_EMAIL=admin@croptera.local
DEV_ADMIN_PASSWORD=Pa$$w0rd!
DEV_ADMIN_FIRST_NAME=Super
DEV_ADMIN_LAST_NAME=Admin

#== JWT Auth
JWT_SECRET=c28feb1f24d9144ff5d13782f2716def8690e78211b77ddb7dd65bcdd80bf569
JWT_REFRESH_EXPIRATION_TIME=2592000

#== DB
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=12345
DB_DATABASE=croptera-local
DB_SSL_ENABLED=false

#== AWS
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_REGION=eu-central-1
AWS_S3_API_VERSION=2010-12-01
AWS_S3_BUCKET_NAME=croptera-bucket


#== Mailer
MAILER_API_URL=https://api.zeptomail.com/v1.1/email
MAILER_API_TOKEN=
MAILER_FROM_EMAIL=
MAILER_FROM_NAME=prosev

#== NATS
NATS_ENABLED=false
NATS_HOST=localhost
NATS_PORT=4222

#== Redis
REDIS_CACHE_ENABLED=true
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=0

#== Throttler
THROTTLER_TTL=1m
THROTTLER_LIMIT=10
